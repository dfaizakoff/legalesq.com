# --- Old blog: WordPress URLs were /blog/{slug}/ — new site uses /blog/{slug}.html ---
# This wildcard catches the slash-format and rewrites to the .html format.
# It runs BEFORE the attachment/print/feed rules below so they still match.
/blog/*/attachment/*                 /blog.html                       301
/blog/*/print/                       /blog.html                       301
/blog/*/feed/                        /blog.html                       301
/blog/*/                             /blog/:splat.html                301

# --- WordPress tag and category archives ---
/tag/*                               /blog.html                       301
/category/*                          /blog.html                       301

